  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Vous \xEAtes dans un monde envahi par les monstres. Pour survivre, vous
    d\xE9cidez de commercer avec eux.\r\nVous leur vendez des talismans, car ils
    semblent aimer cela.\r\nAfin de pouvoir commercer, vous devez cr\xE9er des masques
    prenant la forme des visages de monstres pour passer inaper\xE7u.\r\nVous les
    reproduisez en fonction des monstres que vous pouvez observer \xE0 travers les
    cam\xE9ras, lesquelles montrent \xE9galement leur avanc\xE9e.\r\nAvant de vous
    rendre dans la boutique, vous devez avoir le masque et le talisman pr\xEAts sur
    la table.\n\nJ pour commencer"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
